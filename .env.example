# Copy to .env and fill in. .env is gitignored — never commit real credentials.

# Duffel (test keys start with duffel_test)
DUFFEL_API_KEY=duffel_test_xxxxxxxxxxxxxxxxxxxxxxx

# How often the background job checks for availability
CHECK_INTERVAL_MINUTES=15

# An already-alerted itinerary must get this much cheaper (percent) to alert again
MIN_PRICE_DROP_PERCENT=5

# SMTP for alert emails (Gmail app password shown as an example)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=you@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=you@gmail.com
SMTP_USE_TLS=true

# Optional
DATABASE_PATH=flights.db
HOST=127.0.0.1
PORT=5000
